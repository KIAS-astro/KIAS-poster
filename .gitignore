# macOS
.DS_Store

# local Claude Code settings (CLAUDE.md is tracked as project documentation)
.claude/

# Python envs / caches (any level)
.venv/
__pycache__/
*.pyc
*.egg-info/

# generated poster output — recreate with `python -m posterkit --year years/<year>`
years/*/drafts/

# Track each year's raw SPHEREx sources (durable if the upstream download URLs
# disappear), but not the derived cutouts — those are regenerated from the raw
# sources by cut_oval / merge_oval (run posterkit.imageprep.fetch_images).
years/*/images/*_cut.png

# large style reference (not needed to build) — the KIAS logo IS tracked
posterkit/assets/2024-Poster.png
